{
  "name": "overlook",
  "version": "0.76.0",
  "description": "A photo library app.",
  "license": "MIT",
  "author": "zts1.com",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,yml,yaml,html}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,yml,yaml,html}\" \".prettierrc.json\"",
    "lint": "npm run lint:agent-context && npm run lint:package && npm run lint:new-files && npm run lint:colors && npm run lint:contrast && eslint . && npm run lint:cycles && npm run lint:dead && npm run lint:types && npm run lint:i18n && npm run lint:licenses",
    "lint:package": "node scripts/check-package-pins.mjs",
    "lint:agent-context": "node scripts/check-agent-context.mjs",
    "lint:i18n": "npm run i18n:check && node scripts/check-i18n-budget.mjs",
    "i18n:extract": "node scripts/i18n-catalog.mjs",
    "i18n:check": "node scripts/i18n-catalog.mjs --check",
    "lint:new-files": "node scripts/check-new-file-size.mjs",
    "lint:contrast": "node scripts/check-color-contrast.mjs",
    "lint:colors": "node scripts/check-renderer-colors.mjs",
    "lint:cycles": "madge --circular --extensions ts,tsx src",
    "lint:dead": "knip",
    "lint:types": "type-coverage --at-least 99.8 --strict && type-coverage -p src/main --at-least 99.8 --strict && type-coverage -p src/preload --at-least 99.8 --strict && type-coverage -p src/renderer --at-least 99.8 --strict",
    "lint:licenses": "node scripts/check-licenses.mjs && node scripts/generate-third-party-notices.mjs --check",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs",
    "licenses:sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/main && tsc --noEmit -p src/preload && tsc --noEmit -p src/renderer && tsc --noEmit -p tests/dom && tsc --noEmit -p .storybook",
    "clean": "node scripts/remove-paths.mjs dist out",
    "dev": "electron-vite dev",
    "build": "npm run clean && electron-vite build",
    "dist": "electron-builder --publish never -c.mac.identity=null && npm run licenses:sbom",
    "dist:win:x64": "electron-builder --publish never --win --x64 && npm run licenses:sbom",
    "dist:win:arm64": "electron-builder --publish never --win --arm64 && npm run licenses:sbom",
    "dist:signed": "electron-builder --publish never && npm run licenses:sbom",
    "dist:signed:provisioned": "node scripts/package-signed-provisioned.mjs && npm run licenses:sbom",
    "package": "npm run build && npm run dist",
    "package:win:x64": "npm run build && npm run dist:win:x64",
    "package:win:arm64": "npm run build && npm run dist:win:arm64",
    "package:signed": "npm run build && npm run dist:signed",
    "package:signed:provisioned": "npm run build && npm run dist:signed:provisioned",
    "ci": "npm run check:interop-acceptance && npm run lint && npm run format:check && npm run check:changesets && npm run check:acceptance-coverage && npm run check:a11y-budget && npm run docs:gov && npm run test:cov && npm run build",
    "test:compile": "node scripts/remove-paths.mjs .test-dist && tsc -p tsconfig.test.json",
    "test:dom:compile": "node scripts/remove-paths.mjs .test-dist-dom && tsc -p tests/dom",
    "test:unit:run": "node scripts/run-electron-node-test.mjs .test-dist/tests/**/*.test.js",
    "test:dom:run": "node --import ./.test-dist-dom/tests/dom/register.js --test .test-dist-dom/tests/dom/*.test.js",
    "test:dom:inner": "npm run test:dom:compile && npm run test:dom:run",
    "test:dom": "npm run test:dom:inner",
    "test:run": "node scripts/run-test-lanes.mjs test:unit:run test:dom:run",
    "test:inner": "npm run typecheck && npm run test:compile && npm run test:dom:compile && npm run test:run",
    "test": "npm run test:inner",
    "test:cov:inner": "npm run typecheck && npm run test:compile && npm run test:dom:compile && c8 npm run test:run",
    "test:cov": "npm run test:cov:inner",
    "test:workflows": "node --test tests/tooling/ci-lifecycle.test.ts tests/tooling/release-workflow.test.ts tests/tooling/version-cut-workflow.test.ts tests/tooling/acceptance-coverage-retry.test.ts",
    "interop:generate-contract": "npm run test:compile && node scripts/generate-interop-contract.mjs",
    "check:interop-acceptance": "node scripts/check-interop-acceptance.mjs",
    "check:interop-closeout": "node scripts/check-interop-acceptance.mjs --require-manual",
    "coverage:summary": "node scripts/report-coverage-summary.mjs",
    "check:changesets": "changeset status",
    "check:acceptance-coverage": "node scripts/check-e2e-coverage-map.mjs && node scripts/check-acceptance-coverage-diff.mjs",
    "check:a11y-budget": "node scripts/check-a11y-budget.mjs",
    "docs:gov": "node scripts/check-docs-gov.mjs",
    "test:pcloud:live": "npm run test:compile && OVERLOOK_PCLOUD_LIVE=1 ELECTRON_RUN_AS_NODE=1 electron --test '.test-dist/tests/backup/pcloud-live-contract.test.js'",
    "test:google-drive:live": "npm run test:compile && OVERLOOK_GOOGLE_DRIVE_LIVE=1 ELECTRON_RUN_AS_NODE=1 electron --test '.test-dist/tests/backup/google-drive-live-contract.test.js'",
    "test:icloud:native-smoke": "node scripts/verify-macos-icloud-native-smoke.mjs",
    "test:llm:live:inner": "npm run test:compile && OVERLOOK_LLM_LIVE=1 ELECTRON_RUN_AS_NODE=1 electron --test '.test-dist/tests/llm/live-contract.test.js'",
    "test:llm:live": "npm run test:llm:live:inner",
    "test:icloud:live": "node scripts/verify-macos-icloud-live-contract.mjs",
    "diagnose:google-oauth": "node scripts/diagnose-google-oauth.ts",
    "test:e2e:inner": "playwright test",
    "test:e2e:windows-import:inner": "playwright test --grep @windows-import",
    "test:e2e": "npm run test:e2e:inner",
    "test:e2e:visible:inner": "OVERLOOK_E2E_VISIBLE=1 playwright test",
    "test:e2e:visible": "npm run test:e2e:visible:inner",
    "test:e2e:ui:inner": "playwright test --ui",
    "test:e2e:ui": "npm run test:e2e:ui:inner",
    "test:e2e:headed:inner": "playwright test --headed",
    "test:e2e:headed": "npm run test:e2e:headed:inner",
    "test:perf:inner": "playwright test --config playwright.perf.config.ts",
    "test:perf": "npm run test:perf:inner",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:stories:inner": "test-storybook",
    "test:stories": "npm run test:stories:inner",
    "test:stories:ci:inner": "rm -f test-results/a11y-visited-stories.txt && STORYBOOK_A11Y_TEST=off npm run build:storybook && concurrently -k -s first -n sb,test \"http-server storybook-static --host 127.0.0.1 --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && OVERLOOK_A11Y_VISITED=test-results/a11y-visited-stories.txt test-storybook --url http://127.0.0.1:6006\" && node scripts/check-a11y-budget.mjs --visited test-results/a11y-visited-stories.txt --lane stories",
    "test:stories:ci": "npm run test:stories:ci:inner",
    "seed:dev": "OVERLOOK_SEED=96 electron-vite dev",
    "seed:perf": "OVERLOOK_SEED_SYNTHETIC=200000 electron-vite dev",
    "benchmark:cold-storage": "node scripts/benchmark-cold-storage.mjs",
    "benchmark:embedding": "node scripts/benchmark-embedding-model.mjs",
    "postinstall": "node scripts/ensure-electron-binary.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@electron/osx-sign": "2.7.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.16.22",
    "@formatjs/intl": "4.1.20",
    "@happy-dom/global-registrator": "20.12.2",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@storybook/test-runner": "0.24.4",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "axe-playwright": "2.2.2",
    "c8": "12.0.0",
    "concurrently": "10.0.5",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-formatjs": "6.6.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "knip": "6.32.3",
    "lint-staged": "17.4.1",
    "lucide-react": "1.34.0",
    "madge": "8.0.0",
    "node-test-github-reporter": "1.3.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "10.1.25",
    "storybook": "10.5.10",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "wait-on": "9.1.0",
    "zod": "4.5.4"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "uuid": "11.1.1",
    "madge": {
      "typescript": "$typescript"
    },
    "type-coverage": {
      "typescript": "$typescript"
    },
    "axe-playwright": {
      "axe-core": "$axe-core"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "adm-zip": "0.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@overlook/touch-id@0.1.0": true,
    "@overlook/windows-interop@0.1.0": true,
    "better-sqlite3-multiple-ciphers": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@42.6.1": true,
    "onnxruntime-node@1.29.0": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "exifr": "7.1.3",
    "mpegts.js": "1.8.2",
    "onnxruntime-node": "1.29.0",
    "openai": "7.9.0",
    "sharp": "0.35.4",
    "sqlite-vec": "0.1.9"
  },
  "optionalDependencies": {
    "@overlook/touch-id": "0.1.0",
    "@overlook/windows-interop": "0.1.0"
  }
}
