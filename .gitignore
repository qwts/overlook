# No trailing slash: a bare `node_modules/` pattern matches directories only, so a
# symlink named node_modules (how a linked worktree borrows an install) slips past
# it and a later `git add -A` tracks it — machine-local path and all (PR #836 review).
node_modules
dist/
out/
release/
storybook-static/
coverage/
.test-dist/
.test-dist-dom/
.guard/
native/touch-id/build/
native/touch-id/prebuilds/
playwright-report/
test-results/
.DS_Store
Overlook Design System.zip
.claude/settings.local.json
